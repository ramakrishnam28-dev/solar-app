{
  "expo": {
    "name": "RCAL Station",
    "slug": "rcal-station",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rcalstation",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.rcal.station",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#166534",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.rcal.station",
      "supportsTablet": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#166534",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID to unlock RCAL Station."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "extra": {
      "apiUrl": "https://solarepc-api.ramakrishnam28.workers.dev",
      "webUrl": "https://app.rcalsolar.com"
    }
  }
}
