{
  "expo": {
    "name": "RCAL Station",
    "slug": "rcal-station",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rcalstation",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.rcal.station",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#168056",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.rcal.station",
      "supportsTablet": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#168056",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID to unlock RCAL Station."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pick photos of customer documents and site work.",
          "cameraPermission": "Take photos of customer documents and installation work.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Tag site photos and check in at the installation site."
        }
      ],
      "expo-document-picker"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "extra": {
      "apiUrl": "https://solarepc-api.ramakrishnam28.workers.dev",
      "webUrl": "https://app.rcalsolar.com"
    }
  }
}